{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npx vite build",
      "outputDirectory": "dist"
    },
    "standalone": {
      "root": "standalone",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "standalone"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "standalone"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
